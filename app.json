{
  "configVersion": "v3",
  "app": {
    "appId": 1131097,
    "appName": "Redline",
    "appType": "watchface",
    "version": { "code": 1, "name": "1.0.0" },
    "icon": "icon.png",
    "vender": "tranquiloSan",
    "description": "Tachometer-style watch face: the needle revs through each hour (RPH), the gear shows the hour."
  },
  "permissions": ["data:user.hd.step", "data:user.hd.heart_rate"],
  "runtime": {
    "apiVersion": { "compatible": "3.0", "target": "3.0", "minVersion": "3.0" }
  },
  "targets": {
    "default": {
      "module": {
        "watchface": {
          "path": "watchface/index",
          "main": 1,
          "editable": 0,
          "lockscreen": 1
        }
      },
      "platforms": [{ "st": "r", "dw": 466 }]
    }
  },
  "i18n": { "en-US": { "appName": "Redline" } },
  "defaultLanguage": "en-US"
}
